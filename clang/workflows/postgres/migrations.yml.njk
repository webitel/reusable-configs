name: Workflow (migrations / ((( name -))) )
run-name: "${{ github.event.repository.name }}@${{ github.ref_name }}#${{ github.run_number }} - ${{ github.event.head_commit.message }}"

on:
  push:
    branches: [ ((( branch | default("main") ))), "v[0-9]+.[0-9]+" ]

permissions: { contents: read }
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  matrix:
    name: Load build matrix
    runs-on: [ arc-runner-set ]
    defaults:
      run:
        shell: bash

    outputs:
      pairs: ${{ steps.read.outputs.pairs }}
      codenames-csv: ${{ steps.read.outputs.codenames-csv }}

    steps:
      - name: Checkout matrix file
        uses: actions/checkout@v6
        with:
          sparse-checkout: .github/pg-matrix.json
          sparse-checkout-cone-mode: false
          fetch-depth: 1

      - name: Parse pg-matrix.json
        id: read
        run: |
          set -euo pipefail
          f=.github/pg-matrix.json
          {
            printf 'pairs=%s\n'         "$(jq -c '[ .[] | {"pg-major", codename} ] | unique' "$f")"
            printf 'codenames-csv=%s\n' "$(jq -r '[ .[].codename ] | unique | join(",")' "$f")"
          } >> "${GITHUB_OUTPUT}"

  version:
    name: Version
    needs: [ matrix ]
    uses: webitel/reusable-workflows/.github/workflows/_version.yml@((( version )))
    permissions:
      contents: read
      id-token: write

    with:
      development-branch: ${{ github.event.repository.default_branch }}
      triggered-branch: ${{ github.ref_name }}
      arch: all
      codename: ${{ needs.matrix.outputs.codenames-csv }}

  build:
    name: Migrations package (pg${{ matrix.pg-major }}/${{ matrix.codename }})
    needs: [ matrix, version ]
    runs-on: [ arc-runner-set ]
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(needs.matrix.outputs.pairs) }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6
        with:
          fetch-depth: 2

      - name: Build package
        uses: webitel/reusable-workflows/actions/nfpm-build@nfpm-build-v2
        with:
          nfpm-version: latest
          formats: deb
          target: dist
          maintainer: Webitel <support@webitel.com>
          homepage: https://webitel.com
          arch: all
          platform: linux
          package-name: ((( migrations["package-name"] )))-${{ matrix.pg-major }}
          package-description: ((( migrations["package-description"] | default("Webitel PostgreSQL migrations") )))
          version: ${{ needs.version.outputs.version }}
          release: ${{ github.run_number }}
          prerelease: ${{ github.event.repository.default_branch == github.ref_name && 'dev' || '' }}
          version-metadata: ${{ matrix.codename }}
          contents: |
            src=((( migrations["src-dir"] | default("webitel") ))) dst=/usr/share/postgresql/${{ matrix.pg-major }}/((( migrations["src-dir"] | default("webitel") ))) type=tree mode=0755

      - name: Upload per-pair artifacts
        uses: actions/upload-artifact@v7
        with:
          name: build-packages-all-${{ matrix.codename }}-${{ matrix.pg-major }}
          retention-days: 7
          compression-level: 9
          path: dist

  merge:
    name: Merge package artifacts (all)
    needs: [ build ]
    runs-on: [ arc-runner-set ]

    steps:
      - name: Download per-pair artifacts
        uses: actions/download-artifact@v8
        with:
          pattern: build-packages-all-*
          merge-multiple: true
          path: dist

      - name: Upload merged artifact
        uses: actions/upload-artifact@v7
        with:
          name: build-packages-all
          retention-days: 7
          compression-level: 9
          path: dist
