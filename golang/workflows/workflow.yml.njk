{% set semver = versioning == "semver" %}
name: Workflow ( (((- name -))) )
run-name: "((( name )))@${{ github.ref_name }}#${{ github.run_number }} - ${{ github.event.head_commit.message }}"

on:
  push:
{% if semver %}
    branches: [ ((( branch | default("main") ))) ]
    tags: [ "v[0-9]+.[0-9]+.[0-9]+" ]
{% else %}
    branches: [ ((( branch | default("main") ))), "v[0-9]+.[0-9]+" ]
{% endif %}

permissions: { contents: read }
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  prepare:
    name: Prepare
    uses: webitel/reusable-workflows/.github/workflows/golang-prepare.yml@((( version )))
    permissions:
      contents: read
      pull-requests: read
      id-token: write

    with:
      versioning: ((( versioning | default("calver") )))
      development-branch: ${{ github.event.repository.default_branch }}
      triggered-branch: ${{ github.ref_name }}
{% if semver and releases %}
      release-branch-component: true
{% endif %}
      arch: ((( build.arch | default("${{ vars.BUILD_ARCH }}") )))
      codename: ((( build.codename | default("${{ vars.DEB_CODENAME }}") )))

  checks:
    name: Checks
    needs: [ prepare ]
    uses: webitel/reusable-workflows/.github/workflows/golang-checks.yml@((( version )))
    permissions:
      contents: read
      actions: read
      security-events: write

    with:
      changes: ${{ needs.prepare.outputs.changes }}
{% if build["cgo-enabled"] %}
      cgo-enabled: true
{% endif %}

{% if build.crypto %}
  crypto:
    name: Crypto dependency
    needs: [ prepare ]
    runs-on: [ arc-runner-set ]
    outputs:
      depends: ${{ steps.depends.outputs.depends }}

    steps:
      - name: Checkout go.mod
        uses: actions/checkout@v7
        with:
          sparse-checkout: go.mod
          sparse-checkout-cone-mode: false

      - name: Resolve webitel-cryptoctl dependency
        id: depends
        shell: bash
        env:
          BRANCH: ${{ github.ref_name }}
        run: |
          ver=$(awk '$1 == "github.com/webitel/webitel-cryptoctl" { print $2; exit }
            $1 == "require" && $2 == "github.com/webitel/webitel-cryptoctl" { print $3; exit }' go.mod)
          if [[ -z $ver ]]; then
            echo "::error::build.crypto is set but go.mod does not require github.com/webitel/webitel-cryptoctl"
            exit 1
          fi

          if [[ $BRANCH =~ ^v[0-9]{2}\.[0-9]{1,2}$ ]]; then
            if [[ ! $ver =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
              echo "::error::webitel-cryptoctl $ver is a pseudo-version; release branches require a tag"
              exit 1
            fi
            depends="webitel-cryptoctl (>= ${ver#v})"
          else
            depends="webitel-cryptoctl"
          fi

          echo "Depends: $depends"
          echo "depends=$depends" >> "$GITHUB_OUTPUT"

{% endif %}
  compile:
    name: Build
    needs: [ prepare(((- ", crypto" if build.crypto ))) ]
    strategy:
      matrix:
        arch: ${{ fromJSON(needs.prepare.outputs.arch-matrix) }}

    uses: webitel/reusable-workflows/.github/workflows/golang-build.yml@((( version )))
    with:
      arch: ${{ matrix.arch }}
      binary-name: ((( build["binary-name"] )))
{% if build["main-path"] %}
      main-path: ((( build["main-path"] )))
{% endif %}
      ldflags: >
{% if build.crypto or build["crypto-dir"] %}
        ((( build["ldflags"] | trim | safe | indent(8) )))
        -X github.com/webitel/crypto/cryptobox.defaultSystemDir=/var/lib/webitel/crypto
{% else %}
        ((( build["ldflags"] | safe | indent(8) )))
{% endif %}

      version: ${{ needs.prepare.outputs.version }}
      version-build: ${{ needs.prepare.outputs.version-build }}
      prerelease: ${{ needs.prepare.outputs.prerelease }}
{% if build["cgo-enabled"] %}
      cgo-enabled: true
{% endif %}
      package-name: ((( name )))
      package-description: ${{ github.event.repository.description }}
      package-contents: |
        ((( build["package-contents"] | safe | indent(8) )))

{% if build.crypto %}
      package-depends: ((( (build["package-depends"] ~ ", ") if build["package-depends"] )))${{ needs.crypto.outputs.depends }}
{% else %}
      package-depends: ((( build["package-depends"] )))
{% endif %}
      scripts: |
        ((( build["scripts"] | safe | indent(8) )))

{% if not semver %}
  deploy:
    name: Deploy
    if: github.event.repository.private == false
    needs: [ prepare, compile ]
    uses: webitel/reusable-workflows/.github/workflows/_deploy.yml@((( version )))
    secrets: inherit
    with:
      repository-environment: ${{ needs.prepare.outputs.repository-environment }}
      deb-package-pattern: "((( name )))*.deb"

{% endif %}
  publish:
    name: Publish
{% if semver %}
    needs: [ prepare, compile ]
    if: github.event.repository.private == false
{% else %}
    needs: [ prepare, compile, deploy ]
    if: always() && !cancelled() && github.event.repository.private == false && needs.compile.result == 'success' && (needs.deploy.result == 'success' || needs.deploy.result == 'skipped')
{% endif %}
    strategy:
      fail-fast: false
      matrix:
        arch: ${{ fromJSON(needs.prepare.outputs.arch-matrix) }}
        codename: ${{ fromJSON(needs.prepare.outputs.codename-matrix) }}

    uses: webitel/reusable-workflows/.github/workflows/_publish-deb.yml@((( version )))
    secrets: inherit
    with:
      arch: ${{ matrix.arch }}
      repository-environment: ${{ needs.prepare.outputs.repository-environment }}
      deb-package-pattern: "((( name )))*.deb"
      deb-component: ${{ needs.prepare.outputs.deb-component }}
      deb-codename: ${{ matrix.codename }}
      deb-s3-bucket-name: ${{ vars.DEB_S3_BUCKET_NAME }}
      deb-s3-bucket-region: ${{ vars.DEB_S3_DEFAULT_REGION }}
      deb-s3-endpoint: ${{ vars.DEB_S3_ENDPOINT }}
      deb-s3-force-path-style: ${{ vars.DEB_S3_FORCE_PATH_STYLE == 'true' }}

  release:
    name: Release
    needs: [ prepare, publish ]
    if: needs.prepare.outputs.release-tag != '' && needs.publish.result == 'success'
    uses: webitel/reusable-workflows/.github/workflows/_release.yml@((( version )))
    permissions: { contents: write }
    with:
      tag: ${{ needs.prepare.outputs.release-tag }}
      tag-target-commitish: ${{ github.sha }}
