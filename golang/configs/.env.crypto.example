# For more crypto environment variables see: https://github.com/webitel/crypto
#
# Directory with the .cipher / .search key files. Default in Webitel builds.
#CRYPTO_DIR=/var/lib/webitel/crypto

# Encryption keyring: inline keys (comma or newline separated) or a key file; _KEYFILE wins.
#CRYPTO_CIPHER_KEYRING=
#CRYPTO_CIPHER_KEYFILE=/var/lib/webitel/crypto/.cipher

# Key file reload period (e.g. 5s). 0 disables.
#CRYPTO_CIPHER_KEYFILE_POLL=0

# Search (blind index) keyring. Required by schemas with searchable fields.
#CRYPTO_SEARCH_KEYRING=
#CRYPTO_SEARCH_KEYFILE=/var/lib/webitel/crypto/.search

# Key file permission check: strict or unsafe (warn only).
#CRYPTO_KEYFILE_POLICY=strict

# Schema overlay: a file, or an inline schema / {"dir","files"} include.
#CRYPTO_SCHEMA_FILE=
#CRYPTO_SCHEMA=
